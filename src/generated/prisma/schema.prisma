// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  coverImage  String?
  content     String
  published   Boolean   @default(false)
  status      String    @default("published")
  writerId    String?
  writer      Writer?   @relation(fields: [writerId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  comments    Comment[]

  @@index([slug])
  @@map("blog_posts")
}

model Writer {
  id        String     @id @default(cuid())
  name      String
  email     String?
  bio       String
  avatar    String?
  socials   String
  createdAt DateTime   @default(now())
  posts     BlogPost[]

  @@map("writers")
}

model DevProject {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  link        String
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("dev_projects")
}

model ContentProject {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  imageUrl    String
  link        String
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("content_projects")
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  confirmedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("subscribers")
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  post            BlogPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  name            String
  email           String?
  notifyOnReply   Boolean   @default(false)
  body            String    @db.Text
  createdAt       DateTime  @default(now())

  @@index([postId])
  @@index([parentCommentId])
  @@map("comments")
}
